Core Logic as Executable Pseudocode
7.1 Main Flow
function runWizard(options):

Step 1. checklist = loadChecklist(options.schemaVersion).

Step 2. if options.partialSpecification: answers = loadPartialSpecification(options.partialSpecification).

else: answers = {}.

Step 3. for item in checklist.items:

panel = renderPanel(item, answers).

response = collectResponse(panel).

validation = validateField(item, response).

if not validation.valid: displayError(validation.errors); repeat step 3.

answers[item.field] = response.

Step 4. consistency = checkConsistency(answers).

if not consistency.valid: displayError(consistency.errors); return to the offending panel.

Step 5. warnings = generateWarnings(answers).

Step 6. specification = buildSpecification(answers, checklist.version).

Step 7. saveSpecification(specification, options.outputFilePath, options.outputFormat).

Step 8. report = formatReport(specification, warnings, checklist.version, options.toolVersion, timestamp).

Step 9. return {specification, report, warnings}.

7.2 Validate Field
function validateField(item, response):

if item.required and response == null: return {valid: false, errors: ["field is required"]}.

if item.permittedValues and response not in item.permittedValues: return {valid: false, errors: ["value not in permitted set"]}.

if item.type == "number" and not isNumber(response): return {valid: false, errors: ["value must be a number"]}.

if item.type == "boolean" and not isBoolean(response): return {valid: false, errors: ["value must be a boolean"]}.

return {valid: true}.

7.3 Check Consistency
function checkConsistency(answers):

errors = [].

if answers.selection_effects_declared and answers.selection_function == null:

errors.push({field: "selection_function", message: "selection effects declared but no selection function specified"}).

if answers.measurement_uncertainty_declared and answers.measurement_kernel == null and answers.measurement_justification == null:

errors.push({field: "measurement_kernel", message: "measurement uncertainty declared but no kernel or justification specified"}).

if answers.dependence_declared and answers.dependence_structure == null:

errors.push({field: "dependence_structure", message: "dependence declared but no structure specified"}).

if answers.scan_family == "pair" and answers.p_max == null:

errors.push({field: "p_max", message: "pair family used but no P_max specified"}).

if answers.scan_family == "fixed" and answers.fixed_windows == null:

errors.push({field: "fixed_windows", message: "fixed family used but no fixed windows specified"}).

if answers.support_rule == "S2" and answers.support_padding == null:

errors.push({field: "support_padding", message: "S2 support used but no padding rule specified"}).

if answers.support_rule == "S3" and answers.support_external_procedure == null:

errors.push({field: "support_external_procedure", message: "S3 support used but no external procedure specified"}).

if answers.null_model == "KDE" and answers.null_bandwidth_rule == null:

errors.push({field: "null_bandwidth_rule", message: "KDE null used but no bandwidth rule specified"}).

if answers.effective_null_continuity == false and answers.jittering_applied == false:

errors.push({field: "jittering_applied", message: "effective null has atoms but no jittering prescription specified"}).

return {valid: errors.length == 0, errors: errors}.

7.4 Generate Warnings
function generateWarnings(answers):

warnings = [].

if answers.selection_effects_declared and answers.selection_function == null:

warnings.push({code: "NO_SELECTION_FUNCTION", message: "selection effects declared but no selection function"}).

if answers.measurement_uncertainty_declared and answers.measurement_kernel == null:

warnings.push({code: "NO_MEASUREMENT_KERNEL", message: "measurement uncertainty declared but no kernel"}).

if answers.dependence_declared and answers.dependence_structure == null:

warnings.push({code: "NO_DEPENDENCE_STRUCTURE", message: "dependence declared but no simulation procedure"}).

if answers.support_rule == "S2" and answers.support_padding == null:

warnings.push({code: "NO_SUPPORT_PADDING", message: "S2 support used but no padding rule"}).

if answers.null_model == "KDE" and answers.null_bandwidth_rule == null:

warnings.push({code: "NO_BANDWIDTH_RULE", message: "KDE null used but no bandwidth rule"}).

if answers.effective_null_continuity == false and answers.jittering_applied == false:

warnings.push({code: "NO_JITTERING_PRESCRIPTION", message: "effective null has atoms but no jittering prescription"}).

if answers.N < recommendedN(answers.target_tail):

warnings.push({code: "N_BELOW_RECOMMENDED", message: "N is below the recommended minimum for the target tail"}).

if answers.tail_definition == ">" and not answers.tail_definition_declared:

warnings.push({code: "TAIL_DEFINITION_NOT_DECLARED", message: "tail definition is > but no declaration"}).

if answers.multiplicity_procedure == null:

warnings.push({code: "NO_MULTIPLICITY_PROCEDURE", message: "multiplicity procedure not stated"}).

return warnings.

7.5 Build Specification
function buildSpecification(answers, checklistVersion):

return {checklist_version: checklistVersion, tool_version: toolVersion, timestamp: now(), scientific_question: answers.scientific_question, selection_effects_declared: answers.selection_effects_declared, selection_function: answers.selection_function, selection_n_fixed: answers.selection_n_fixed, selection_order: answers.selection_order, measurement_uncertainty_declared: answers.measurement_uncertainty_declared, measurement_kernel: answers.measurement_kernel, measurement_justification: answers.measurement_justification, dependence_declared: answers.dependence_declared, dependence_structure: answers.dependence_structure, clustering_step: answers.clustering_step, clustering_settings: answers.clustering_settings, clustering_reproduction: answers.clustering_reproduction, transformation: answers.transformation, transformation_justification: answers.transformation_justification, jittering_applied: answers.jittering_applied, jittering_scale: answers.jittering_scale, jittering_rule: answers.jittering_rule, support_rule: answers.support_rule, support_details: answers.support_details, support_padding: answers.support_padding, support_external_procedure: answers.support_external_procedure, null_model: answers.null_model, null_density: answers.null_density, null_parameters: answers.null_parameters, null_provenance: answers.null_provenance, null_bandwidth_rule: answers.null_bandwidth_rule, effective_null: answers.effective_null, effective_null_continuity: answers.effective_null_continuity, scan_family: answers.scan_family, g_min_value: answers.g_min_value, g_min_units: answers.g_min_units, p_max: answers.p_max, boundary_convention: answers.boundary_convention, empty_w_convention: answers.empty_w_convention, tie_breaking_rule: answers.tie_breaking_rule, gap_selection_rule: answers.gap_selection_rule, nuisance_estimation: answers.nuisance_estimation, gap_exclusion_loop: answers.gap_exclusion_loop, truncated_likelihood: answers.truncated_likelihood, iteration_count: answers.iteration_count, tail_definition: answers.tail_definition, N: answers.N, target_tail: answers.target_tail, monte_carlo_uncertainty: answers.monte_carlo_uncertainty, multiplicity_procedure: answers.multiplicity_procedure, multiple_nulls_handling: answers.multiple_nulls_handling}.

7.6 Recommended N
function recommendedN(targetTail):

if targetTail >= 0.05: return 1900.

if targetTail >= 0.01: return 10000.

if targetTail >= 0.001: return 100000.

if targetTail >= 0.0001: return 1000000.

if targetTail >= 0.00001: return 10000000.

return 100000000.

