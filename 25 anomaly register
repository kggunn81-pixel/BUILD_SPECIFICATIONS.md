Core Logic as Executable Pseudocode
7.1 Create Anomaly
function createAnomaly(anomaly, evidenceFiles, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. validationResult = validateAnomaly(anomaly). If invalid, return {error: "invalid anomaly", details: validationResult.errors}.

Step 3. if anomaly.stag_annotation is not null: result = validateSTAGRecord(anomaly.stag_annotation); if invalid, return {error: "invalid STAG annotation", details: result.errors}.

Step 4. if anomaly.null_model_result is not null: validation = validateNullModelResult(anomaly.null_model_result); if invalid, return {error: "invalid Null-Model Protocol result", details: validation.errors}.

Step 5. anomalyId = generateAnomalyId().

anomaly.anomaly_id = anomalyId.

anomaly.version = 1.

anomaly.moderation_status = "pending".

anomaly.deposit_date = now().

anomaly.depositor_id = auth.depositor_id.

anomaly.depositor_affiliation = auth.depositor_affiliation.

anomaly.provenance = {source: provenance.source, tool_version: provenance.tool_version, notes: provenance.notes}.

Step 6. insertAnomaly(anomaly).

Step 7. for evidence in anomaly.evidence_for: insertEvidence(anomalyId, "for", evidence).

for evidence in anomaly.evidence_against: insertEvidence(anomalyId, "against", evidence).

Step 8. for relatedId in anomaly.related_anomalies: insertRelatedAnomaly(anomalyId, relatedId, "related", null).

Step 9. if anomaly.stag_annotation is not null: insertSTAGLink(anomalyId, anomaly.stag_annotation.annotation_id).

Step 10. if anomaly.null_model_result is not null: insertNullModelLink(anomalyId, anomaly.null_model_result.result_id).

Step 11. if anomaly.numerical_verification_result is not null: insertVerificationLink(anomalyId, anomaly.numerical_verification_result.verification_id).

Step 12. insertLifecycle(anomalyId, "proposed", now(), null, auth.depositor_id).

Step 13. insertProvenance(anomalyId, auth.depositor_id, auth.depositor_affiliation, provenance.source, provenance.tool_version, "create").

Step 14. insertModeration(anomalyId, null, "pending", null, null).

Step 15. insertAuditLog("create", "anomaly", anomalyId, auth.depositor_id, "success", {anomaly: anomaly}).

Step 16. return {anomaly_id: anomalyId, status: "created"}.

7.2 Read Anomaly
function readAnomaly(anomalyId, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. anomaly = selectAnomaly(anomalyId).

if anomaly is null: return {error: "not found"}.

Step 3. evidence = selectEvidence(anomalyId).

relatedAnomalies = selectRelatedAnomalies(anomalyId).

stagLink = selectSTAGLink(anomalyId).

nullModelLink = selectNullModelLink(anomalyId).

verificationLink = selectVerificationLink(anomalyId).

lifecycle = selectLifecycle(anomalyId).

provenance = selectProvenance(anomalyId).

moderation = selectModeration(anomalyId).

Step 4. deposit = reconstructAnomaly(anomaly, evidence, relatedAnomalies, stagLink, nullModelLink, verificationLink, lifecycle, provenance, moderation).

Step 5. insertAuditLog("read", "anomaly", anomalyId, auth.depositor_id, "success", null).

Step 6. return {deposit: deposit}.

7.3 Update Anomaly
function updateAnomaly(anomalyId, anomaly, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectAnomaly(anomalyId).

if existing is null: return {error: "not found"}.

Step 3. validationResult = validateAnomaly(anomaly). If invalid, return {error: "invalid anomaly", details: validationResult.errors}.

Step 4. newVersion = existing.version + 1.

updateAnomaly(anomalyId, {version: newVersion, supersedes: existing.version, superseded_by: null}).

Step 5. if anomaly.anomaly_status != existing.anomaly_status: insertLifecycle(anomalyId, anomaly.anomaly_status, now(), anomaly.status_reason, auth.depositor_id).

Step 6. insertProvenance(anomalyId, auth.depositor_id, auth.depositor_affiliation, provenance.source, provenance.tool_version, "update").

Step 7. insertAuditLog("update", "anomaly", anomalyId, auth.depositor_id, "success", {anomaly: anomaly}).

Step 8. return {anomaly_id: anomalyId, version: newVersion, status: "updated"}.

7.4 Delete Anomaly
function deleteAnomaly(anomalyId, provenance, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectAnomaly(anomalyId).

if existing is null: return {error: "not found"}.

Step 3. if config.softDelete: updateAnomaly(anomalyId, {deleted_at: now()}).

else: deleteAnomaly(anomalyId).

Step 4. insertAuditLog("delete", "anomaly", anomalyId, auth.depositor_id, "success", null).

Step 5. return {anomaly_id: anomalyId, status: "deleted"}.

7.5 Query Anomalies
function queryAnomalies(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildQuerySQL(query).

Step 3. results = executeSQL(sql).

Step 4. anomalies = results.map(row => selectAnomaly(row.anomaly_id)).

Step 5. insertAuditLog("query", "anomaly", null, auth.depositor_id, "success", {query: query}).

Step 6. return {anomalies: anomalies, count: anomalies.length, pagination: {offset: query.offset, limit: query.limit}}.

7.6 Aggregate Anomalies
function aggregateAnomalies(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAggregateSQL(query).

Step 3. results = executeSQL(sql).

Step 4. insertAuditLog("aggregate", "anomaly", null, auth.depositor_id, "success", {query: query}).

Step 5. return {results: results}.

7.7 Full-Text Search
function fullTextSearch(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildFullTextSQL(query).

Step 3. results = executeSQL(sql).

Step 4. anomalies = results.map(row => selectAnomaly(row.anomaly_id)).

Step 5. insertAuditLog("search", "anomaly", null, auth.depositor_id, "success", {query: query}).

Step 6. return {anomalies: anomalies, count: anomalies.length}.

7.8 Export Anomaly
function exportAnomaly(anomalyId, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. deposit = readAnomaly(anomalyId, auth).deposit.

Step 3. if format == "json": output = deposit.

else if format == "provo": output = exportToPROVO(deposit).output.

else if format == "turtle": output = serializeToTurtle(deposit).

Step 4. insertAuditLog("export", "anomaly", anomalyId, auth.depositor_id, "success", {format: format}).

Step 5. return {output: output, format: format}.

7.9 Bulk Import
function bulkImport(file, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. anomalies = parseBulkFile(file).

Step 3. results = [].

for anomaly in anomalies:

result = createAnomaly(anomaly, anomaly.evidence_files, provenance, auth).

results.push(result).

Step 4. insertAuditLog("bulk_import", "anomaly", null, auth.depositor_id, "success", {count: anomalies.length}).

Step 5. return {results: results, count: results.length}.

7.10 Bulk Export
function bulkExport(query, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. anomalies = queryAnomalies(query, auth).anomalies.

Step 3. if format == "json": output = anomalies.

else if format == "jsonl": output = anomalies.map(a => JSON.stringify(a)).join("\n").

else if format == "provo": output = anomalies.map(a => exportToPROVO(a).output).join("\n").

Step 4. insertAuditLog("bulk_export", "anomaly", null, auth.depositor_id, "success", {count: anomalies.length}).

Step 5. return {output: output, count: anomalies.length}.

7.11 Moderate Anomaly
function moderateAnomaly(anomalyId, moderationStatus, moderationNotes, auth):

Step 1. validateAuth(auth, "moderator"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectAnomaly(anomalyId).

if existing is null: return {error: "not found"}.

Step 3. updateAnomaly(anomalyId, {moderation_status: moderationStatus}).

insertModeration(anomalyId, auth.depositor_id, moderationStatus, moderationNotes, now()).

Step 4. insertAuditLog("moderate", "anomaly", anomalyId, auth.depositor_id, "success", {status: moderationStatus, notes: moderationNotes}).

Step 5. return {anomaly_id: anomalyId, status: moderationStatus}.

7.12 Find Related Anomalies
function findRelatedAnomalies(anomalyId, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. anomaly = selectAnomaly(anomalyId).

if anomaly is null: return {error: "not found"}.

Step 3. related = selectRelatedAnomalies(anomalyId).

Step 4. sameAnomalyCandidates = [].

for otherAnomaly in selectAllAnomalies():

if otherAnomaly.anomaly_id == anomalyId: continue.

if otherAnomaly.field == anomaly.field and otherAnomaly.anomaly_type == anomaly.anomaly_type:

if similarDescription(otherAnomaly.description, anomaly.description):

sameAnomalyCandidates.push(otherAnomaly).

Step 5. return {related: related, same_anomaly_candidates: sameAnomalyCandidates}.

7.13 Anomaly Map
function anomalyMap(auth, options):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. anomalies = selectAllAnomalies().

Step 3. map = {fields: [], scales: [], points: []}.

for anomaly in anomalies:

if anomaly.field not in map.fields: map.fields.push(anomaly.field).

if anomaly.scale not in map.scales: map.scales.push(anomaly.scale).

map.points.push({anomaly_id: anomaly.anomaly_id, field: anomaly.field, scale: anomaly.scale, status: anomaly.anomaly_status, relation: anomaly.relation_to_standard_model}).

Step 4. return {map: map}.

7.14 Audit Log
function auditLog(query, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAuditSQL(query).

Step 3. results = executeSQL(sql).

Step 4. return {results: results}.

7.15 Backup
function backup(auth, options):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. if options.format == "sql": output = dumpDatabaseSQL().

else if options.format == "json": output = dumpDatabaseJSON().

Step 3. insertAuditLog("backup", "database", null, auth.depositor_id, "success", {format: options.format}).

Step 4. return {output: output, format: options.format}.

7.16 Restore
function restore(file, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. loadDatabase(file).

Step 3. insertAuditLog("restore", "database", null, auth.depositor_id, "success", {file: file}).

Step 4. return {status: "restored"}.

