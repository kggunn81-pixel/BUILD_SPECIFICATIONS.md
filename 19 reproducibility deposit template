Core Logic as Executable Pseudocode
7.1 Main Flow
function createDeposit(authorCode, authorData, authorSeeds, authorResults, depositType, metadata, schemaVersions, language, outputDir):

Step 1. createDirectoryStructure(outputDir, depositType).

Step 2. createMetadataFile(outputDir, metadata, depositType, schemaVersions, language).

Step 3. copyCode(outputDir, authorCode).

Step 4. copyData(outputDir, authorData).

Step 5. copySeeds(outputDir, authorSeeds).

Step 6. if authorResults is not null: copyResults(outputDir, authorResults).

else: createResultsPlaceholder(outputDir).

Step 7. copySchemas(outputDir, depositType, schemaVersions).

Step 8. copyCodebook(outputDir, depositType, schemaVersions).

Step 9. createReadme(outputDir, metadata, depositType, language).

Step 10. createLicense(outputDir).

Step 11. createCitation(outputDir, metadata).

Step 12. createSetupScript(outputDir, language).

Step 13. createRunScript(outputDir, language).

Step 14. createCheckScript(outputDir, language).

Step 15. createChecklist(outputDir, depositType).

Step 16. createManifest(outputDir).

Step 17. createPlaceholders(outputDir, language).

Step 18. createReproducibilityRecord(outputDir).

Step 19. return {depositDir: outputDir, manifest: readManifest(outputDir), metadata: readMetadata(outputDir)}.

7.2 Create Directory Structure
function createDirectoryStructure(outputDir, depositType):

createDirectory(outputDir).

createDirectory(outputDir + "/code").

createDirectory(outputDir + "/data").

createDirectory(outputDir + "/seeds").

createDirectory(outputDir + "/results").

createDirectory(outputDir + "/schemas").

createDirectory(outputDir + "/codebook").

createDirectory(outputDir + "/logs").

createDirectory(outputDir + "/tests").

7.3 Create Metadata File
function createMetadataFile(outputDir, metadata, depositType, schemaVersions, language):

metadataObj = {title: metadata.title, authors: metadata.authors, date: metadata.date, abstract: metadata.abstract, keywords: metadata.keywords, deposit_type: depositType, stag_schema_version: schemaVersions.stag, null_model_schema_version: schemaVersions.nullModel, language: language, template_version: TEMPLATE_VERSION}.

writeJSON(outputDir + "/metadata.json", metadataObj).

7.4 Create Manifest
function createManifest(outputDir):

files = listAllFiles(outputDir).

manifest = {files: [], generated: now()}.

for file in files:

hash = sha256(file).

size = fileSize(file).

manifest.files.push({path: relativePath(file, outputDir), hash: hash, size: size}).

writeJSON(outputDir + "/manifest.json", manifest).

7.5 Create Checklist
function createChecklist(outputDir, depositType):

checklist = generateChecklist(depositType).

writeMarkdown(outputDir + "/checklist.md", checklist).

7.6 Create README
function createReadme(outputDir, metadata, depositType, language):

readme = generateReadme(metadata, depositType, language).

writeMarkdown(outputDir + "/README.md", readme).

7.7 Create Setup Script
function createSetupScript(outputDir, language):

if language == "python": script = pythonSetupScript().

else if language == "r": script = rSetupScript().

else if language == "javascript": script = jsSetupScript().

else: script = genericSetupScript().

writeExecutable(outputDir + "/setup.sh", script).

7.8 Create Run Script
function createRunScript(outputDir, language):

if language == "python": script = pythonRunScript().

else if language == "r": script = rRunScript().

else if language == "javascript": script = jsRunScript().

else: script = genericRunScript().

writeExecutable(outputDir + "/run.sh", script).

7.9 Create Check Script
function createCheckScript(outputDir, language):

if language == "python": script = pythonCheckScript().

else if language == "r": script = rCheckScript().

else if language == "javascript": script = jsCheckScript().

else: script = genericCheckScript().

writeExecutable(outputDir + "/check.sh", script).

7.10 Create Reproducibility Record
function createReproducibilityRecord(outputDir):

record = {template_version: TEMPLATE_VERSION, setup_time: null, run_time: null, check_time: null, seed: null, results_hash: null}.

writeJSON(outputDir + "/logs/reproducibility.json", record).

7.11 Copy Schemas
function copySchemas(outputDir, depositType, schemaVersions):

if depositType == "stag_only" or depositType == "both":

copy(STAG_JSON_SCHEMA, outputDir + "/schemas/stag_schema.json").

copy(STAG_SHACL_SCHEMA, outputDir + "/schemas/stag_shacl.ttl").

if depositType == "null_model_only" or depositType == "both":

copy(NULL_MODEL_SCHEMA, outputDir + "/schemas/null_model_schema.json").

7.12 Copy Codebook
function copyCodebook(outputDir, depositType, schemaVersions):

if depositType == "stag_only" or depositType == "both":

copy(STAG_CODEBOOK, outputDir + "/codebook/stag_codebook.md").

copy(STAG_WORKED_EXAMPLES, outputDir + "/codebook/stag_worked_examples.md").

if depositType == "null_model_only" or depositType == "both":

copy(NULL_MODEL_SPECIFICATION, outputDir + "/codebook/null_model_specification.md").

copy(NULL_MODEL_WORKED_EXAMPLES, outputDir + "/codebook/null_model_worked_examples.md").

