Core Logic as Executable Pseudocode
7.1 Create Record
function createRecord(recordJson, provenance, auth):

Step 1. validateAuth(auth, "writer"). If not authorized, return {error: "unauthorized"}.

Step 2. validationResult = validateSTAGRecord(recordJson). If invalid, return {error: "invalid record", details: validationResult.errors}.

Step 3. node = extractNode(recordJson).

upsertNode(node).

Step 4. if recordJson.event_node_id is not null: event = extractEvent(recordJson); upsertEvent(event).

Step 5. partition = extractPartition(recordJson).

upsertPartition(partition).

Step 6. model = extractModel(recordJson).

upsertModel(model).

Step 7. revision = extractRevision(recordJson, provenance).

upsertRevision(revision).

Step 8. for each domainAnnotation in recordJson.domain_annotations: upsertDomainAnnotation(domainAnnotation).

Step 9. annotationId = generateAnnotationId().

insertAnnotation(annotationId, recordJson, node, event, partition, model, revision).

Step 10. insertProvenance(annotationId, provenance).

Step 11. insertAuditLog("create", "annotation", annotationId, provenance.annotator_id, "success", {recordJson: recordJson}).

Step 12. return {annotation_id: annotationId, status: "created"}.

7.2 Read Record
function readRecord(annotationId, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. annotation = selectAnnotation(annotationId).

if annotation is null: return {error: "not found"}.

Step 3. node = selectNode(annotation.node_id).

event = annotation.event_node_id is not null ? selectEvent(annotation.event_node_id) : null.

partition = selectPartition(annotation.partition_id, annotation.partition_version).

model = selectModel(annotation.model_id).

revision = selectRevision(annotation.revision_id).

domainAnnotations = selectDomainAnnotations(annotation.node_id, annotation.partition_id, annotation.partition_version).

provenance = selectProvenance(annotationId).

Step 4. record = reconstructRecord(annotation, node, event, partition, model, revision, domainAnnotations, provenance).

Step 5. insertAuditLog("read", "annotation", annotationId, auth.annotator_id, "success", null).

Step 6. return {record: record}.

7.3 Update Record
function updateRecord(annotationId, recordJson, provenance, auth):

Step 1. validateAuth(auth, "writer"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectAnnotation(annotationId).

if existing is null: return {error: "not found"}.

Step 3. validationResult = validateSTAGRecord(recordJson). If invalid, return {error: "invalid record", details: validationResult.errors}.

Step 4. newRevisionId = generateRevisionId().

newRevision = {revision_id: newRevisionId, annotation_id: annotationId, supersedes: existing.revision_id, superseded_by: null, revision_date: now(), theory_version: recordJson.theory_version, annotator_id: provenance.annotator_id}.

updateRevision(existing.revision_id, {superseded_by: newRevisionId}).

insertRevision(newRevision).

Step 5. updateAnnotation(annotationId, recordJson, newRevisionId).

Step 6. insertProvenance(annotationId, provenance).

Step 7. insertAuditLog("update", "annotation", annotationId, provenance.annotator_id, "success", {recordJson: recordJson}).

Step 8. return {annotation_id: annotationId, revision_id: newRevisionId, status: "updated"}.

7.4 Delete Record
function deleteRecord(annotationId, provenance, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectAnnotation(annotationId).

if existing is null: return {error: "not found"}.

Step 3. if config.softDelete: updateAnnotation(annotationId, {deleted_at: now()}).

else: deleteAnnotation(annotationId).

Step 4. insertAuditLog("delete", "annotation", annotationId, provenance.annotator_id, "success", null).

Step 5. return {annotation_id: annotationId, status: "deleted"}.

7.5 Query Records
function queryRecords(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildQuerySQL(query).

Step 3. results = executeSQL(sql).

Step 4. records = results.map(row => selectAnnotation(row.annotation_id)).

Step 5. insertAuditLog("query", "annotation", null, auth.annotator_id, "success", {query: query}).

Step 6. return {records: records, count: records.length, pagination: {offset: query.offset, limit: query.limit}}.

7.6 Aggregate Records
function aggregateRecords(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAggregateSQL(query).

Step 3. results = executeSQL(sql).

Step 4. insertAuditLog("aggregate", "annotation", null, auth.annotator_id, "success", {query: query}).

Step 5. return {results: results}.

7.7 Full-Text Search
function fullTextSearch(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildFullTextSQL(query).

Step 3. results = executeSQL(sql).

Step 4. records = results.map(row => selectAnnotation(row.annotation_id)).

Step 5. insertAuditLog("search", "annotation", null, auth.annotator_id, "success", {query: query}).

Step 6. return {records: records, count: records.length}.

7.8 Export Record
function exportRecord(annotationId, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. record = readRecord(annotationId, auth).record.

Step 3. if format == "json": output = record.

else if format == "provo": output = exportToPROVO(record).output.

else if format == "turtle": output = serializeToTurtle(record).

Step 4. insertAuditLog("export", "annotation", annotationId, auth.annotator_id, "success", {format: format}).

Step 5. return {output: output, format: format}.

7.9 Bulk Import
function bulkImport(file, provenance, auth):

Step 1. validateAuth(auth, "writer"). If not authorized, return {error: "unauthorized"}.

Step 2. records = parseBulkFile(file).

Step 3. results = [].

for record in records:

result = createRecord(record, provenance, auth).

results.push(result).

Step 4. insertAuditLog("bulk_import", "annotation", null, provenance.annotator_id, "success", {count: records.length}).

Step 5. return {results: results, count: results.length}.

7.10 Bulk Export
function bulkExport(query, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. records = queryRecords(query, auth).records.

Step 3. if format == "json": output = records.

else if format == "jsonl": output = records.map(r => JSON.stringify(r)).join("\n").

else if format == "provo": output = records.map(r => exportToPROVO(r).output).join("\n").

Step 4. insertAuditLog("bulk_export", "annotation", null, auth.annotator_id, "success", {count: records.length}).

Step 5. return {output: output, count: records.length}.

7.11 Audit Log
function auditLog(query, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAuditSQL(query).

Step 3. results = executeSQL(sql).

Step 4. return {results: results}.

7.12 Backup
function backup(auth, options):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. if options.format == "sql": output = dumpDatabaseSQL().

else if options.format == "json": output = dumpDatabaseJSON().

Step 3. insertAuditLog("backup", "database", null, auth.annotator_id, "success", {format: options.format}).

Step 4. return {output: output, format: options.format}.

7.13 Restore
function restore(file, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. loadDatabase(file).

Step 3. insertAuditLog("restore", "database", null, auth.annotator_id, "success", {file: file}).

Step 4. return {status: "restored"}.

