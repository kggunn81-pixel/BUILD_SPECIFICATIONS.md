Core Logic as Executable Pseudocode
7.1 Create Deposit
function createDeposit(deposit, files, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. validationResult = validateDeposit(deposit). If invalid, return {error: "invalid deposit", details: validationResult.errors}.

Step 3. if deposit.stag_annotations is not null:

for annotation in deposit.stag_annotations:

result = validateSTAGRecord(annotation). If invalid, return {error: "invalid STAG annotation", details: result.errors}.

Step 4. if deposit.null_model_results is not null:

for result in deposit.null_model_results:

validation = validateNullModelResult(result). If invalid, return {error: "invalid Null-Model Protocol result", details: validation.errors}.

Step 5. workId = generateWorkId().

deposit.work_id = workId.

deposit.version = 1.

deposit.moderation_status = "pending".

deposit.deposit_date = now().

deposit.depositor_id = auth.depositor_id.

deposit.depositor_affiliation = auth.depositor_affiliation.

deposit.provenance = {source: provenance.source, tool_version: provenance.tool_version, notes: provenance.notes}.

Step 6. insertWork(deposit).

Step 7. for file in files: fileHash = sha256(file); insertFile(workId, file.path, fileHash, file.size, file.format).

Step 8. if deposit.stag_annotations is not null: for annotation in deposit.stag_annotations: insertSTAGAnnotation(workId, annotation).

Step 9. if deposit.null_model_results is not null: for result in deposit.null_model_results: insertNullModelResult(workId, result).

Step 10. insertProvenance(workId, auth.depositor_id, auth.depositor_affiliation, provenance.source, provenance.tool_version, "create").

Step 11. insertModeration(workId, null, "pending", null, null).

Step 12. insertAuditLog("create", "work", workId, auth.depositor_id, "success", {deposit: deposit}).

Step 13. return {work_id: workId, status: "created"}.

7.2 Read Deposit
function readDeposit(workId, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. work = selectWork(workId).

if work is null: return {error: "not found"}.

Step 3. files = selectFiles(workId).

stagAnnotations = selectSTAGAnnotations(workId).

nullModelResults = selectNullModelResults(workId).

provenance = selectProvenance(workId).

moderation = selectModeration(workId).

Step 4. deposit = reconstructDeposit(work, files, stagAnnotations, nullModelResults, provenance, moderation).

Step 5. insertAuditLog("read", "work", workId, auth.depositor_id, "success", null).

Step 6. return {deposit: deposit}.

7.3 Update Deposit
function updateDeposit(workId, deposit, files, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectWork(workId).

if existing is null: return {error: "not found"}.

Step 3. validationResult = validateDeposit(deposit). If invalid, return {error: "invalid deposit", details: validationResult.errors}.

Step 4. newVersion = existing.version + 1.

updateWork(workId, {version: newVersion, supersedes: existing.version, superseded_by: null}).

Step 5. insertProvenance(workId, auth.depositor_id, auth.depositor_affiliation, provenance.source, provenance.tool_version, "update").

Step 6. if files is not null: deleteFiles(workId); for file in files: fileHash = sha256(file); insertFile(workId, file.path, fileHash, file.size, file.format).

Step 7. if deposit.stag_annotations is not null: deleteSTAGAnnotations(workId); for annotation in deposit.stag_annotations: insertSTAGAnnotation(workId, annotation).

Step 8. if deposit.null_model_results is not null: deleteNullModelResults(workId); for result in deposit.null_model_results: insertNullModelResult(workId, result).

Step 9. insertAuditLog("update", "work", workId, auth.depositor_id, "success", {deposit: deposit}).

Step 10. return {work_id: workId, version: newVersion, status: "updated"}.

7.4 Delete Deposit
function deleteDeposit(workId, provenance, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectWork(workId).

if existing is null: return {error: "not found"}.

Step 3. if config.softDelete: updateWork(workId, {deleted_at: now()}).

else: deleteWork(workId).

Step 4. insertAuditLog("delete", "work", workId, auth.depositor_id, "success", null).

Step 5. return {work_id: workId, status: "deleted"}.

7.5 Query Deposits
function queryDeposits(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildQuerySQL(query).

Step 3. results = executeSQL(sql).

Step 4. works = results.map(row => selectWork(row.work_id)).

Step 5. insertAuditLog("query", "work", null, auth.depositor_id, "success", {query: query}).

Step 6. return {works: works, count: works.length, pagination: {offset: query.offset, limit: query.limit}}.

7.6 Aggregate Deposits
function aggregateDeposits(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAggregateSQL(query).

Step 3. results = executeSQL(sql).

Step 4. insertAuditLog("aggregate", "work", null, auth.depositor_id, "success", {query: query}).

Step 5. return {results: results}.

7.7 Full-Text Search
function fullTextSearch(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildFullTextSQL(query).

Step 3. results = executeSQL(sql).

Step 4. works = results.map(row => selectWork(row.work_id)).

Step 5. insertAuditLog("search", "work", null, auth.depositor_id, "success", {query: query}).

Step 6. return {works: works, count: works.length}.

7.8 Export Deposit
function exportDeposit(workId, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. deposit = readDeposit(workId, auth).deposit.

Step 3. if format == "json": output = deposit.

else if format == "provo": output = exportToPROVO(deposit).output.

else if format == "turtle": output = serializeToTurtle(deposit).

else if format == "bibtex": output = generateBibTeX(deposit).

else if format == "ris": output = generateRIS(deposit).

else if format == "csl-json": output = generateCSLJSON(deposit).

Step 4. insertAuditLog("export", "work", workId, auth.depositor_id, "success", {format: format}).

Step 5. return {output: output, format: format}.

7.9 Bulk Import
function bulkImport(file, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. deposits = parseBulkFile(file).

Step 3. results = [].

for deposit in deposits:

result = createDeposit(deposit, deposit.files, provenance, auth).

results.push(result).

Step 4. insertAuditLog("bulk_import", "work", null, auth.depositor_id, "success", {count: deposits.length}).

Step 5. return {results: results, count: results.length}.

7.10 Bulk Export
function bulkExport(query, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. works = queryDeposits(query, auth).works.

Step 3. if format == "json": output = works.

else if format == "jsonl": output = works.map(w => JSON.stringify(w)).join("\n").

else if format == "provo": output = works.map(w => exportToPROVO(w).output).join("\n").

Step 4. insertAuditLog("bulk_export", "work", null, auth.depositor_id, "success", {count: works.length}).

Step 5. return {output: output, count: works.length}.

7.11 Moderate Deposit
function moderateDeposit(workId, moderationStatus, moderationNotes, auth):

Step 1. validateAuth(auth, "moderator"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectWork(workId).

if existing is null: return {error: "not found"}.

Step 3. updateWork(workId, {moderation_status: moderationStatus}).

insertModeration(workId, auth.depositor_id, moderationStatus, moderationNotes, now()).

Step 4. insertAuditLog("moderate", "work", workId, auth.depositor_id, "success", {status: moderationStatus, notes: moderationNotes}).

Step 5. return {work_id: workId, status: moderationStatus}.

7.12 Audit Log
function auditLog(query, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAuditSQL(query).

Step 3. results = executeSQL(sql).

Step 4. return {results: results}.

7.13 Backup
function backup(auth, options):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. if options.format == "sql": output = dumpDatabaseSQL().

else if options.format == "json": output = dumpDatabaseJSON().

Step 3. insertAuditLog("backup", "database", null, auth.depositor_id, "success", {format: options.format}).

Step 4. return {output: output, format: options.format}.

7.14 Restore
function restore(file, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. loadDatabase(file).

Step 3. insertAuditLog("restore", "database", null, auth.depositor_id, "success", {file: file}).

Step 4. return {status: "restored"}.

7.15 Citation Generation
function generateBibTeX(deposit):

return "@" + deposit.work_type + "{" + deposit.work_id + ",\n" + " title = {" + deposit.title + "},\n" + " author = {" + join(deposit.authors, " and ") + "},\n" + " year = {" + year(deposit.date) + "},\n" + " publisher = {" + deposit.publisher + "},\n" + " doi = {" + deposit.identifiers.DOI + "}\n" + "}".

The RIS and CSL-JSON generators follow the same pattern.

