6.3 Dependency Resolution
At startup, the master reads the module registry and resolves the dependencies. If a module depends on another module that is not registered, the master reports the missing dependency and refuses to load the dependent module. If a module depends on a module that is registered but not started, the master starts the dependency first.

The dependency order is computed by a topological sort. Cycles are reported and refused.

Core Logic as Executable Pseudocode
7.1 Main Flow
function runMaster(options):

Step 1. moduleRegistry = loadModuleRegistry(options.moduleRegistryFile).

Step 2. dependencyOrder = resolveDependencies(moduleRegistry).

if dependencyOrder is null: return {error: "dependency cycle detected"}.

Step 3. sharedCore = initializeSharedCore(options).

Step 4. startedModules = [].

for moduleId in dependencyOrder:

module = moduleRegistry.get(moduleId).

compatibility = checkVersionCompatibility(module, sharedCore).

if not compatibility.compatible: reportIncompatibility(module, compatibility.reason); continue.

startResult = startModule(module, sharedCore).

if startResult.error: reportError(module, startResult.error); continue.

startedModules.push(module).

Step 5. startWebInterface(sharedCore, startedModules).

Step 6. startRestApi(sharedCore, startedModules).

Step 7. startGraphQLApi(sharedCore, startedModules).

Step 8. startCommandLineInterface(sharedCore, startedModules).

Step 9. startHealthCheck(sharedCore, startedModules).

Step 10. return {sharedCore: sharedCore, startedModules: startedModules, moduleRegistry: moduleRegistry}.

7.2 Load Module Registry
function loadModuleRegistry(file):

registry = parseJSON(file).

validateRegistry(registry).

return registry.

7.3 Resolve Dependencies
function resolveDependencies(registry):

order = [].

visited = new Set().

visiting = new Set().

function visit(moduleId):

if visited.has(moduleId): return true.

if visiting.has(moduleId): return false.

visiting.add(moduleId).

module = registry.get(moduleId).

for depId in module.module_dependencies:

if not visit(depId): return false.

visiting.delete(moduleId).

visited.add(moduleId).

order.push(moduleId).

return true.

for moduleId in registry.keys():

if not visit(moduleId): return null.

return order.

7.4 Initialize Shared Core
function initializeSharedCore(options):

schemaRegistry = new SharedSchemaRegistry().

schemaRegistry.load(STAG_SCHEMA, NULL_MODEL_SCHEMA, DEPOSIT_SCHEMA).

provenanceDatabase = new SharedProvenanceDatabase(options.databaseConfig).

authenticationLayer = new SharedAuthenticationLayer(options.authenticationConfig).

reportingLayer = new SharedReportingLayer(options.reportingConfig).

return {schemaRegistry: schemaRegistry, provenanceDatabase: provenanceDatabase, authenticationLayer: authenticationLayer, reportingLayer: reportingLayer}.

7.5 Start Module
function startModule(module, sharedCore):

config = loadModuleConfiguration(module.module_id).

result = module.startModule(config).

if result.error: return {error: result.error}.

insertProvenanceRecord(sharedCore.provenanceDatabase, module.module_id, "module", module.module_id, "system", null, now(), "master", MASTER_VERSION, "create").

insertAuditLog(sharedCore, "start", module.module_id, module.module_id, "system", "success", {config: config}).

return {status: "started"}.

7.6 Stop Module
function stopModule(module, sharedCore):

result = module.stopModule().

insertProvenanceRecord(sharedCore.provenanceDatabase, module.module_id, "module", module.module_id, "system", null, now(), "master", MASTER_VERSION, "delete").

insertAuditLog(sharedCore, "stop", module.module_id, module.module_id, "system", "success", null).

return {status: "stopped"}.

7.7 Health Check
function healthCheck(module):

return module.healthCheck().

7.8 Unified Search
function unifiedSearch(query, sharedCore, startedModules):

results = [].

for module in startedModules:

if module.getSearchFunction is not null:

moduleResults = module.getSearchFunction(query).

results.push({module_id: module.module_id, results: moduleResults}).

return {results: results, count: results.reduce((sum, r) => sum + r.results.length, 0)}.

7.9 Backup
function backup(sharedCore, startedModules, options):

backupObj = {shared_core: sharedCore.backup(), modules: {}}.

for module in startedModules:

backupObj.modules[module.module_id] = module.backup().

if options.format == "json": output = JSON.stringify(backupObj).

else if options.format == "sql": output = dumpDatabaseSQL().

insertAuditLog(sharedCore, "backup", "database", null, "system", "success", {format: options.format}).

return {output: output, format: options.format}.

7.10 Restore
function restore(file, sharedCore, startedModules):

backupObj = parseBackup(file).

sharedCore.restore(backupObj.shared_core).

for module in startedModules:

module.restore(backupObj.modules[module.module_id]).

insertAuditLog(sharedCore, "restore", "database", null, "system", "success", {file: file}).

return {status: "restored"}.

7.11 Version Compatibility Check
function checkVersionCompatibility(module, sharedCore):

moduleMajor = parseMajor(module.module_version).

sharedCoreMajor = parseMajor(sharedCore.version).

if moduleMajor != sharedCoreMajor: return {compatible: false, reason: "major version mismatch"}.

moduleDependencies = module.module_dependencies.

for depId in moduleDependencies:

dep = moduleRegistry.get(depId).

if dep is null: return {compatible: false, reason: "missing dependency " + depId}.

return {compatible: true}.

7.12 Audit Log
function insertAuditLog(sharedCore, operation, moduleId, recordType, recordId, userId, result, details):

auditEntry = {audit_id: generateAuditId(), operation: operation, module_id: moduleId, record_type: recordType, record_id: recordId, user_id: userId, timestamp: now(), result: result, details: details}.

sharedCore.provenanceDatabase.insertAuditLog(auditEntry).

7.13 Provenance Record
function insertProvenanceRecord(provenanceDatabase, moduleId, recordType, recordId, userId, userAffiliation, timestamp, source, toolVersion, operation):

provenanceRecord = {provenance_id: generateProvenanceId(), module_id: moduleId, record_type: recordType, record_id: recordId, user_id: userId, user_affiliation: userAffiliation, timestamp: timestamp, source: source, tool_version: toolVersion, operation: operation}.

provenanceDatabase.insert(provenanceRecord).

