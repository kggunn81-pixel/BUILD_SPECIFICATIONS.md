return ruleSet.rules.map(rule => ({number: rule.number, name: rule.name, description: rule.description})).

7.5 Check Version Compatibility
function checkVersionCompatibility(recordSchemaVersion, librarySchemaVersion):

recordMajor = parseMajor(recordSchemaVersion).

recordMinor = parseMinor(recordSchemaVersion).

libraryMajor = parseMajor(librarySchemaVersion).

libraryMinor = parseMinor(librarySchemaVersion).

if recordMajor != libraryMajor: return {compatible: false, reason: "major version mismatch"}.

if recordMinor > libraryMinor: return {compatible: false, reason: "record is newer than library"}.

return {compatible: true}.

