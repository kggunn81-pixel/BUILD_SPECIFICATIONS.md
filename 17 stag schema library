7.9 Rule Engine
The rule engine is a collection of pure functions, one per rule. Each function takes a STAG record and returns pass or a violation. The functions are organized by rule number. The engine executes the rules in numeric order.

function rule1(record):

if record.intervention_classification == "Non_definitional" and record.cross_domain_counterfactual_dependence in ["Yes", "No"]:

requiredFields = ["model_reference", "counterfactual_intervention", "counterfactual_description", "counterfactual_result", "material_change_test", "material_change_result"].

for field in requiredFields:

if record[field] == null: return {field: field, value: null, message: "Rule 1: field " + field + " required"}.

return PASS.

function rule16(record):

descriptions = record.source_nodes.concat(record.target_nodes).

for pair in descriptions:

if pair[0].S == pair[1].S and pair[0].M == pair[1].M and pair[0].G == pair[1].G:

if record.node_identity.decision != "merged":

return {field: "node_identity.decision", value: record.node_identity.decision, message: "Rule 16: two descriptions share S, M, G; node_identity must be merged"}.

return PASS.

function rule24(record):

if record.node_identity.decision == "merged":

if record.descriptions.have_different_lagrangians:

if record.node_identity.m_equivalence_basis == null or record.node_identity.m_equivalence_witness == null:

return {field: "node_identity.m_equivalence_basis", value: null, message: "Rule 24: merged decision on different Lagrangians requires both m_equivalence_basis and m_equivalence_witness"}.

return PASS.

function rule29(record):

if record.derived_display_label == "STAG-Discovered":

condA = (record.cited_numerical_result.citation_scope == "annotated_model") or record.material_change_computed_by_annotator.

condB = (record.scale_separation.band_source == "external_reference") and (record.scale_separation.band_source_citation != null) and (record.scale_separation.band_min_ratio >= record.scale_separation.minimum).

condC = (record.independence_of_material_change_evidence == "independent").

condD = (record.material_change_test_result_independence == "independent").

if condA and condB and condC and condD:

if anyConditionFlaggedInterpretive(record): return PASS with status anchored_with_stated_limitations.

return PASS with status anchored.

return PASS with status preliminary or candidate.

return PASS.

The remaining rules follow the same pattern.

