Core Logic as Executable Pseudocode
7.1 Create Scale
function createScale(scale, files, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. validationResult = validateScale(scale). If invalid, return {error: "invalid scale", details: validationResult.errors}.

Step 3. if scale.stag_annotation is not null: result = validateSTAGRecord(scale.stag_annotation); if invalid, return {error: "invalid STAG annotation", details: result.errors}.

Step 4. if scale.numerical_verification_result is not null: validation = validateVerificationResult(scale.numerical_verification_result); if invalid, return {error: "invalid verification result", details: validation.errors}.

Step 5. if scale.work_reference is not null: work = lookupWork(scale.work_reference); if work is null: scale.work_reference_unresolved = true.

Step 6. scaleId = generateScaleId().

scale.scale_id = scaleId.

scale.version = 1.

scale.moderation_status = "pending".

scale.deposit_date = now().

scale.depositor_id = auth.depositor_id.

scale.depositor_affiliation = auth.depositor_affiliation.

scale.provenance = {source: provenance.source, tool_version: provenance.tool_version, notes: provenance.notes}.

scale.order_of_magnitude = floor(log10(abs(scale.scale_value))).

Step 7. insertScale(scale).

Step 8. for relation in scale.related_scales: insertScaleRelation(scaleId, relation.related_scale_id, relation.relation_type, relation.relation_note).

insertScaleRelation(relation.related_scale_id, scaleId, inverseRelation(relation.relation_type), relation.relation_note).

Step 9. if scale.stag_annotation is not null: insertSTAGLink(scaleId, scale.stag_annotation.annotation_id).

Step 10. if scale.numerical_verification_result is not null: insertVerificationLink(scaleId, scale.numerical_verification_result.verification_id).

Step 11. if scale.work_reference is not null: insertWorkLink(scaleId, scale.work_reference).

Step 12. insertProvenance(scaleId, auth.depositor_id, auth.depositor_affiliation, provenance.source, provenance.tool_version, "create").

Step 13. insertModeration(scaleId, null, "pending", null, null).

Step 14. insertAuditLog("create", "scale", scaleId, auth.depositor_id, "success", {scale: scale}).

Step 15. return {scale_id: scaleId, status: "created"}.

7.2 Read Scale
function readScale(scaleId, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. scale = selectScale(scaleId).

if scale is null: return {error: "not found"}.

Step 3. relations = selectScaleRelations(scaleId).

stagLink = selectSTAGLink(scaleId).

verificationLink = selectVerificationLink(scaleId).

workLink = selectWorkLink(scaleId).

provenance = selectProvenance(scaleId).

moderation = selectModeration(scaleId).

Step 4. deposit = reconstructScale(scale, relations, stagLink, verificationLink, workLink, provenance, moderation).

Step 5. insertAuditLog("read", "scale", scaleId, auth.depositor_id, "success", null).

Step 6. return {deposit: deposit}.

7.3 Update Scale
function updateScale(scaleId, scale, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectScale(scaleId).

if existing is null: return {error: "not found"}.

Step 3. validationResult = validateScale(scale). If invalid, return {error: "invalid scale", details: validationResult.errors}.

Step 4. newVersion = existing.version + 1.

updateScale(scaleId, {version: newVersion, supersedes: existing.version, superseded_by: null}).

Step 5. insertProvenance(scaleId, auth.depositor_id, auth.depositor_affiliation, provenance.source, provenance.tool_version, "update").

Step 6. insertAuditLog("update", "scale", scaleId, auth.depositor_id, "success", {scale: scale}).

Step 7. return {scale_id: scaleId, version: newVersion, status: "updated"}.

7.4 Delete Scale
function deleteScale(scaleId, provenance, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectScale(scaleId).

if existing is null: return {error: "not found"}.

Step 3. if config.softDelete: updateScale(scaleId, {deleted_at: now()}).

else: deleteScale(scaleId).

Step 4. insertAuditLog("delete", "scale", scaleId, auth.depositor_id, "success", null).

Step 5. return {scale_id: scaleId, status: "deleted"}.

7.5 Query Scales
function queryScales(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildQuerySQL(query).

Step 3. results = executeSQL(sql).

Step 4. scales = results.map(row => selectScale(row.scale_id)).

Step 5. insertAuditLog("query", "scale", null, auth.depositor_id, "success", {query: query}).

Step 6. return {scales: scales, count: scales.length, pagination: {offset: query.offset, limit: query.limit}}.

7.6 Aggregate Scales
function aggregateScales(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAggregateSQL(query).

Step 3. results = executeSQL(sql).

Step 4. insertAuditLog("aggregate", "scale", null, auth.depositor_id, "success", {query: query}).

Step 5. return {results: results}.

7.7 Full-Text Search
function fullTextSearch(query, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildFullTextSQL(query).

Step 3. results = executeSQL(sql).

Step 4. scales = results.map(row => selectScale(row.scale_id)).

Step 5. insertAuditLog("search", "scale", null, auth.depositor_id, "success", {query: query}).

Step 6. return {scales: scales, count: scales.length}.

7.8 Export Scale
function exportScale(scaleId, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. deposit = readScale(scaleId, auth).deposit.

Step 3. if format == "json": output = deposit.

else if format == "provo": output = exportToPROVO(deposit).output.

else if format == "turtle": output = serializeToTurtle(deposit).

Step 4. insertAuditLog("export", "scale", scaleId, auth.depositor_id, "success", {format: format}).

Step 5. return {output: output, format: format}.

7.9 Bulk Import
function bulkImport(file, provenance, auth):

Step 1. validateAuth(auth, "depositor"). If not authorized, return {error: "unauthorized"}.

Step 2. scales = parseBulkFile(file).

Step 3. results = [].

for scale in scales:

result = createScale(scale, scale.files, provenance, auth).

results.push(result).

Step 4. insertAuditLog("bulk_import", "scale", null, auth.depositor_id, "success", {count: scales.length}).

Step 5. return {results: results, count: results.length}.

7.10 Bulk Export
function bulkExport(query, format, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. scales = queryScales(query, auth).scales.

Step 3. if format == "json": output = scales.

else if format == "jsonl": output = scales.map(s => JSON.stringify(s)).join("\n").

else if format == "provo": output = scales.map(s => exportToPROVO(s).output).join("\n").

Step 4. insertAuditLog("bulk_export", "scale", null, auth.depositor_id, "success", {count: scales.length}).

Step 5. return {output: output, count: scales.length}.

7.11 Moderate Scale
function moderateScale(scaleId, moderationStatus, moderationNotes, auth):

Step 1. validateAuth(auth, "moderator"). If not authorized, return {error: "unauthorized"}.

Step 2. existing = selectScale(scaleId).

if existing is null: return {error: "not found"}.

Step 3. updateScale(scaleId, {moderation_status: moderationStatus}).

insertModeration(scaleId, auth.depositor_id, moderationStatus, moderationNotes, now()).

Step 4. insertAuditLog("moderate", "scale", scaleId, auth.depositor_id, "success", {status: moderationStatus, notes: moderationNotes}).

Step 5. return {scale_id: scaleId, status: moderationStatus}.

7.12 Find Related Scales
function findRelatedScales(scaleId, auth):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. scale = selectScale(scaleId).

if scale is null: return {error: "not found"}.

Step 3. relations = selectScaleRelations(scaleId).

above = relations.filter(r => r.relation_type == "above").

below = relations.filter(r => r.relation_type == "below").

adjacent = relations.filter(r => r.relation_type == "adjacent").

sameOrder = relations.filter(r => r.relation_type == "same_order").

related = relations.filter(r => r.relation_type == "related").

Step 4. return {above: above, below: below, adjacent: adjacent, same_order: sameOrder, related: related}.

7.13 Scale Hierarchy
function scaleHierarchy(auth, options):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. scales = selectAllScales().

Step 3. sorted = scales.sortBy(s => s.scale_value).

Step 4. hierarchy = {nodes: [], edges: []}.

for scale in sorted:

hierarchy.nodes.push({scale_id: scale.scale_id, scale_name: scale.scale_name, scale_value: scale.scale_value, order_of_magnitude: scale.order_of_magnitude, field: scale.field}).

for relation in selectAllScaleRelations():

if relation.relation_type == "above" or relation.relation_type == "adjacent":

hierarchy.edges.push({from: relation.scale_id, to: relation.related_scale_id, type: relation.relation_type}).

Step 5. return {hierarchy: hierarchy}.

7.14 Field Map
function fieldMap(auth, options):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. scales = selectAllScales().

Step 3. map = {fields: [], scales: []}.

for scale in scales:

if scale.field not in map.fields: map.fields.push(scale.field).

map.scales.push({scale_id: scale.scale_id, field: scale.field, scale_value: scale.scale_value, subfield: scale.subfield}).

Step 4. return {map: map}.

7.15 Order-of-Magnitude View
function orderOfMagnitudeView(auth, options):

Step 1. validateAuth(auth, "reader"). If not authorized, return {error: "unauthorized"}.

Step 2. scales = selectAllScales().

Step 3. view = {orders: {}, fields: []}.

for scale in scales:

order = scale.order_of_magnitude.

if order not in view.orders: view.orders[order] = [].

view.orders[order].push({scale_id: scale.scale_id, field: scale.field, scale_value: scale.scale_value}).

if scale.field not in view.fields: view.fields.push(scale.field).

Step 4. return {view: view}.

7.16 Audit Log
function auditLog(query, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. sql = buildAuditSQL(query).

Step 3. results = executeSQL(sql).

Step 4. return {results: results}.

7.17 Backup
function backup(auth, options):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. if options.format == "sql": output = dumpDatabaseSQL().

else if options.format == "json": output = dumpDatabaseJSON().

Step 3. insertAuditLog("backup", "database", null, auth.depositor_id, "success", {format: options.format}).

Step 4. return {output: output, format: options.format}.

7.18 Restore
function restore(file, auth):

Step 1. validateAuth(auth, "admin"). If not authorized, return {error: "unauthorized"}.

Step 2. loadDatabase(file).

Step 3. insertAuditLog("restore", "database", null, auth.depositor_id, "success", {file: file}).

Step 4. return {status: "restored"}.

